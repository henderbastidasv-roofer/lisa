    "google": "node scripts/google.mjs",
    "publicar": "node scripts/publicar.mjs",
    "agente": "node scripts/agente.mjs",
    "numero": "node scripts/numero.mjs",
    "revisar": "node scripts/revisar.mjs",
    "test": "node --import tsx --test pruebas/agenda.test.ts",
