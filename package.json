{
  "name": "lisa",
  "version": "0.1.0",
  "private": true,
  "description": "Lisa: el agente de llamadas para compañías de techos. Hecho por Rufero Pro para ConstruIA.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "claves": "node scripts/claves.mjs",
